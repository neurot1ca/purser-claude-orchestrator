diff --git a/go/internal/enforce/runtime_temp.go b/go/internal/enforce/runtime_temp.go
new file mode 100644
index 00000000..c60f4b84
--- /dev/null
+++ b/go/internal/enforce/runtime_temp.go
@@ -0,0 +1,16 @@
+package enforce
+
+import (
+	"os"
+	"path/filepath"
+)
+
+func runtimeTempDir(prefix string) (string, error) {
+	dir := filepath.Join(defaultPreStateRoot(""), "cache", "tmp")
+	if err := os.MkdirAll(dir, 0700); err == nil {
+		if path, err := os.MkdirTemp(dir, prefix); err == nil {
+			return path, nil
+		}
+	}
+	return os.MkdirTemp("", prefix)
+}
