{
  "oracle": "codex_exec_mcp._agent_command and Server._run_tool_once resume identity",
  "cases": [
    {
      "agent": "opencode",
      "kind": "codex",
      "argv": [
        "agent-bin",
        "--prefix",
        "run",
        "--format",
        "json",
        "--model",
        "google/gemini-test",
        "--variant",
        "high",
        "--",
        "prompt text"
      ]
    },
    {
      "agent": "opencode",
      "kind": "codex-reply",
      "argv": [
        "agent-bin",
        "--prefix",
        "run",
        "--format",
        "json",
        "--model",
        "google/gemini-test",
        "--variant",
        "high",
        "--session",
        "thread-123",
        "--",
        "prompt text"
      ]
    },
    {
      "agent": "opencode",
      "kind": "resume_identity_mismatch",
      "error": "thread belongs to a different agent"
    },
    {
      "agent": "opencode",
      "kind": "read_only",
      "argv": [
        "agent-bin",
        "--prefix",
        "run",
        "--format",
        "json",
        "--model",
        "google/gemini-test",
        "--agent",
        "purser-read-only",
        "--variant",
        "high",
        "--",
        "prompt text"
      ]
    },
    {
      "agent": "opencode",
      "kind": "unsupported_config",
      "error": "unsupported OpenCode config"
    },
    {
      "agent": "agy",
      "kind": "codex",
      "argv": [
        "agent-bin",
        "--prefix",
        "--print",
        "prompt text\nRun every command in the foreground and wait for it; never start background tasks.",
        "--output-format",
        "json",
        "--model",
        "gemini-test",
        "--mode",
        "accept-edits",
        "--dangerously-skip-permissions",
        "--effort",
        "high",
        "--new-project",
        "--add-dir",
        "C:/repo"
      ]
    },
    {
      "agent": "agy",
      "kind": "codex-reply",
      "argv": [
        "agent-bin",
        "--prefix",
        "--print",
        "prompt text\nRun every command in the foreground and wait for it; never start background tasks.",
        "--output-format",
        "json",
        "--model",
        "gemini-test",
        "--mode",
        "accept-edits",
        "--dangerously-skip-permissions",
        "--effort",
        "high",
        "--conversation",
        "thread-123"
      ]
    },
    {
      "agent": "agy",
      "kind": "resume_identity_mismatch",
      "error": "thread belongs to a different agent"
    },
    {
      "agent": "agy",
      "kind": "read_only",
      "argv": [
        "agent-bin",
        "--prefix",
        "--print",
        "prompt text\nRun every command in the foreground and wait for it; never start background tasks.",
        "--output-format",
        "json",
        "--model",
        "gemini-test",
        "--mode",
        "plan",
        "--sandbox",
        "--effort",
        "high",
        "--new-project",
        "--add-dir",
        "C:/repo"
      ]
    },
    {
      "agent": "agy",
      "kind": "unsupported_config",
      "error": "unsupported Antigravity sandbox or config"
    }
  ]
}
